# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=
# Token from @BotFather
BOT_TOKEN=
# Private channel id used as storage, like -100123456789 (the bot must be an ADMIN there)
BIN_CHANNEL=
# Your numeric Telegram user id (ask @userinfobot). Several ids can be separated by commas.
# Needed for the /admin panel where helper bots are added. Leave empty to turn the panel off.
ADMIN_IDS=
